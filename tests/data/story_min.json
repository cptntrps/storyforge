{
  "title": "Q2 review and Q3 plan",
  "governing_thought": "Company X can grow new customers 14% within its $125 cost-per-order target, so Q3 funds each step on evidence.",
  "scqa": {
    "situation": "Company X spends $230k a week on ads across three products with a $125 cost-per-order target.",
    "complication": "June met the target because of one product; the other two run above $190.",
    "question": "How much growth can Q3 buy without breaking the $125 target?",
    "answer": "14% now from proven lines, more only as each test passes."
  },
  "summary_blocks": [
    {
      "name": "goals",
      "lead": "Today we review Q2 and agree the Q3 plan",
      "bullets": [
        "Maximise growth within the $125 cost-per-order target",
        "Validate the new product as the line that keeps cost down",
        "Reduce reliance on one creator"
      ]
    },
    {
      "name": "period_result",
      "lead": "Q2 met the target through one product",
      "bullets": [
        "Product A cut June cost per order to $119, so Company X met its $125 target through one product.",
        "Product A brought 75% of June's new customers, while Products B and C held 72% of June spend."
      ]
    },
    {
      "name": "what_we_see",
      "lead": "Growth outside Product A is expensive",
      "bullets": [
        "Products B and C lost 45% of their new customers, so the lower Q2 cost per order cost Company X growth outside Product A."
      ]
    },
    {
      "name": "what_we_propose",
      "lead": "Fund proven steps, gate the rest",
      "bullets": [
        "Spending $270k a week adds 227 new customers within the $125 target, so Company X buys all the growth the data supports now."
      ]
    },
    {
      "name": "what_we_need_today",
      "lead": "Three approvals",
      "bullets": [
        "Approve the $270k weekly plan",
        "Approve the three gates",
        "Name the decision owner per gate"
      ]
    }
  ],
