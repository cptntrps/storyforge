{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ratecard.json: the diagnosis of a deck, before or after",
  "type": "object",
  "required": ["checks", "diagnostic", "questions"],
  "properties": {
    "subject": {"type": "string"},
    "stage": {"enum": ["before", "after"]},
    "implied_story": {"type": ["object", "null"], "properties": {
      "governing_thought": {"type": "string"}, "slides": {"type": "array", "items": {"type": "integer"}},
      "reasons": {"type": "array", "items": {"type": "string"}}}},
    "story_unclear": {"type": "boolean"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "method", "result", "evidence"], "properties": {
      "id": {"type": "string", "pattern": "^R[0-9]{2}$"},
      "method": {"enum": ["script", "judged"]},
      "result": {"enum": ["PASS", "FAIL", "NA", "DISAGREE"]},
      "evidence": {"type": "array"}}}},
    "diagnostic": {"type": "object", "properties": {
      "gap": {"type": ["string", "null"]},
      "off_path": {"type": "array", "items": {"type": "integer"}},
      "defects": {"type": "array", "items": {"type": "object", "required": ["rank", "text"], "properties": {
        "rank": {"type": "integer"}, "text": {"type": "string"}, "slides": {"type": "array"}}}}}},
    "questions": {"type": "array", "maxItems": 5, "items": {"type": "object", "required": ["q", "default", "why"], "properties": {
      "field": {"type": "string"}, "q": {"type": "string"}, "default": {"type": "string"}, "why": {"type": "string"}}}}
  }
}
